# Environment configuration for Primordial Backend

# Server Configuration
PORT=5001
NODE_ENV=development

# Client URL (for CORS and cookie handling)
CLIENT_URL=http://localhost:5173

# Primary Database: PostgreSQL (Prisma ORM)
DATABASE_URL=postgresql://princechhikara@127.0.0.1:5432/primordial?schema=public

# Secondary Database: MongoDB (Group Chat)
MONGODB_URI=mongodb://127.0.0.1:27017/primordial_chat

# Session Secret (used to sign session ID cookies)
SESSION_SECRET=primordial_development_session_secret_key_change_in_production
