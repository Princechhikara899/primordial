# Root environment example template for Primordial

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Primary Relational Database: PostgreSQL (Prisma ORM)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/primordial?schema=public

# Secondary Document Database: MongoDB (Challenge Group Chat)
MONGODB_URI=mongodb://127.0.0.1:27017/primordial_chat

# Session Secret Key (Used by express-session to sign session cookies)
SESSION_SECRET=primordial_development_session_secret_key_change_in_production
